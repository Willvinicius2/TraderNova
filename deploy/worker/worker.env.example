# Copie para /etc/tradernova/worker.env (chmod 600, dono root). NUNCA faça commit deste arquivo preenchido.
# Pares e intervalos cobertos por um único processo.
TRADERNOVA_WORKER_PAIRS=BTCUSD,ETHUSD,SOLUSD
TRADERNOVA_WORKER_INTERVALS=15,60
TRADERNOVA_WORKER_POLL_SECONDS=30
# Sinais e saúde no Supabase. A chave de serviço só existe neste arquivo, na VM.
TRADERNOVA_WORKER_SIGNAL_STORE=supabase
TRADERNOVA_SUPABASE_URL=https://cnlvasvvmlfwzcecduhy.supabase.co
TRADERNOVA_SUPABASE_SERVICE_KEY=
# Opcional: token de acesso do Expo Push (só se o projeto Expo exigir).
EXPO_ACCESS_TOKEN=
