{
 "strategy": "L46_weekend_effect",
 "name": "Efeito fim de semana do BTC (sexta→segunda)",
 "family": "calendario",
 "sources": [
  "https://quantpedia.com/the-day-of-the-week-effect-in-the-crypto-currency-market/",
  "https://cesifo.org/DocDL/cesifo1_wp6716.pdf",
