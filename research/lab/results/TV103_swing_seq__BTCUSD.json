 "name": "Swing Breakout Sequence (LuxAlgo): rompimento de A depois da sequência de 5 pontos",
 "family": "rompimento",
 "sources": [
  "https://www.tradingview.com/script/LZIqzxDq-Swing-Breakout-Sequence-LuxAlgo",
