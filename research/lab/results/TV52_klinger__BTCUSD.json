 "name": "Klinger Volume Oscillator (everget): KVO cruza o sinal, filtro EMA100 opcional",
 "family": "volume",
 "sources": [
  "https://github.com/everget/tradingview-pinescript-indicators/blob/master/volume/klinger_volume_oscillator.pine",
