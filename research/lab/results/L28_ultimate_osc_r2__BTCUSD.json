{
 "strategy": "L28_ultimate_osc_r2",
 "name": "Ultimate Oscillator: fundo/topo mais alto após nível lv + cruzamento de 50 (Twiggs), saídas de Williams",
 "family": "reversao",
 "sources": [
  "https://www.incrediblecharts.com/indicators/ultimate-oscillator.php",
